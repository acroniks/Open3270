<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Open3270</AssemblyName>
    <RootNamespace>Open3270</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Open3270</Product>
    <AssemblyTitle>Open3270 TN3270 Library</AssemblyTitle>
    <Description>A TN3270 library for .NET applications</Description>
    <Company>Open3270</Company>
    <Copyright>Copyright © 2004-2020 Michael Warriner. Released under the terms of the MIT License.</Copyright>
    <!-- Assembly version deliberately left at the pre-migration value.
         Bump this (and add package metadata) when you decide to publish. -->
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

</Project>
